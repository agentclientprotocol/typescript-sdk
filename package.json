{
  "name": "@agentclientprotocol/sdk",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "The Agent Client Protocol (ACP) is a protocol that standardizes communication between *code editors* (interactive programs for viewing and editing source code) and *coding agents* (programs that use generative AI to autonomously modify code).",
  "homepage": "https://github.com/agentclientprotocol/typescript-sdk#readme",
  "bugs": {
    "url": "https://github.com/agentclientprotocol/typescript-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentclientprotocol/typescript-sdk.git"
  },
  "license": "Apache-2.0",
  "author": "Zed Industries",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/examples",
    "!dist/test-support",
    "schema/v1/schema.json",
    "schema/v1/schema.unstable.json",
    "schema/v2/schema.json",
    "schema/v2/schema.unstable.json",
    "MIGRATION_STABLE_UNSTABLE.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/v1/stable/acp.js",
  "types": "dist/v1/stable/acp.d.ts",
  "exports": {
    ".": {
      "types": "./dist/v1/stable/acp.d.ts",
      "import": "./dist/v1/stable/acp.js",
      "default": "./dist/v1/stable/acp.js"
    },
    "./unstable": {
      "types": "./dist/v1/unstable/acp.d.ts",
      "import": "./dist/v1/unstable/acp.js",
      "default": "./dist/v1/unstable/acp.js"
    },
    "./experimental/v2": {
      "types": "./dist/v2/stable/acp.d.ts",
      "import": "./dist/v2/stable/acp.js",
      "default": "./dist/v2/stable/acp.js"
    },
    "./experimental/v2/unstable": {
      "types": "./dist/v2/unstable/acp.d.ts",
      "import": "./dist/v2/unstable/acp.js",
      "default": "./dist/v2/unstable/acp.js"
    },
    "./experimental/nes": {
      "types": "./dist/nes/acp.d.ts",
      "import": "./dist/nes/acp.js",
      "default": "./dist/nes/acp.js"
    },
    "./experimental/http-client": {
      "types": "./dist/transports/http-stream.d.ts",
      "import": "./dist/transports/http-stream.js",
      "default": "./dist/transports/http-stream.js"
    },
    "./experimental/ws-client": {
      "types": "./dist/transports/ws-stream.d.ts",
      "import": "./dist/transports/ws-stream.js",
      "default": "./dist/transports/ws-stream.js"
    },
    "./experimental/server": {
      "types": "./dist/transports/server.d.ts",
      "import": "./dist/transports/server.js",
      "default": "./dist/transports/server.js"
    },
    "./experimental/node": {
      "types": "./dist/transports/node-adapter.d.ts",
      "import": "./dist/transports/node-adapter.js",
      "default": "./dist/transports/node-adapter.js"
    },
    "./schema/v1/schema.json": "./schema/v1/schema.json",
    "./schema/v1/schema.unstable.json": "./schema/v1/schema.unstable.json",
    "./schema/v2/schema.json": "./schema/v2/schema.json",
    "./schema/v2/schema.unstable.json": "./schema/v2/schema.unstable.json"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run --dir src",
    "generate": "node scripts/generate.js",
    "generate:check": "node scripts/generate.js --skip-download --check",
    "snapshot:nes": "node scripts/snapshot-nes.js",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "package:check": "node scripts/check-package.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "spellcheck": "./scripts/spellcheck.sh",
    "spellcheck:fix": "./scripts/spellcheck.sh --write-changes",
    "check": "npm run generate:check && npm run lint && npm run format:check && npm run spellcheck && npm run typecheck && npm run build && npm run package:check && npm run test && npm run docs:ts:verify",
    "docs:ts:build": "cd src && typedoc --options typedoc.json && typedoc --options typedoc.unstable.json && typedoc --options typedoc.v2.json && typedoc --options typedoc.v2.unstable.json && echo 'TypeScript documentation generated in ./src/docs'",
    "docs:ts:verify": "cd src && typedoc --options typedoc.json --emit none && typedoc --options typedoc.unstable.json --emit none && typedoc --options typedoc.v2.json --emit none && typedoc --options typedoc.v2.unstable.json --emit none && echo 'TypeDoc verification passed'"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.0.0"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser@1.4.4": {
      "js-yaml": "4.3.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^26.0.1",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "http-server": "^14.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.16",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76 || ^4.0.0"
  }
}
